# =============================================================================
# CodeGuard AI Governance OS — Environment Variables
# =============================================================================
# Copy to .env.local and fill in your values:
#   cp .env.example .env.local
# =============================================================================

# ---------- Next.js ----------
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Supabase (required) ----------
# Get from: https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- GraphOS Tenant Configuration (required) ----------
# These identify your organisation inside the governance database.
GRAPHOS_TENANT_ID=your-tenant-or-org-id
GRAPHOS_ORG_ID=your-governance-org-id

# ---------- GraphOS Backend Mode (optional) ----------
# If set, GraphOS uses the Supabase PostgreSQL backend.
# If NOT set, GraphOS uses the in-memory (built-in seed) backend — good for demo/dev.
# GRAPHOS_DB_URL=postgresql://...   # Uncomment for full Postgres mode

# ---------- Stripe (optional — billing) ----------
# Comment these out if you don't need billing.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_...
# NEXT_PUBLIC_STRIPE_TEAM_PRICE_ID=price_...

# ---------- LLM Providers (optional — for CouncilIA debate chamber) ----------
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_X_TITLE=CodeGuard
MISTRAL_API_KEY=your-mistral-key

# ---------- Upstash Redis (optional — rate limiting) ----------
# Without these, the API rate limiter is DISABLED (open to abuse in production).
# Get from: https://console.upstash.com/
# The system works without Redis but is unprotected.
# UPSTASH_REDIS_REST_URL=https://your-region.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ---------- QStash (optional — async job queue) ----------
# Used for background scans. Without this, scans run synchronously.
# QSTASH_TOKEN=your-qstash-token

# ---------- GitHub Integration ----------
# Required for scanning private repos and writing PR comments.
GITHUB_TOKEN=ghp_...

# ---------- Cron Security ----------
# Secret that Vercel Cron sends in Authorization header.
# Generate with: openssl rand -hex 32
# CRON_SECRET=your-random-64-char-secret

# ---------- Internal Security ----------
# Generate all with: openssl rand -hex 32
INTERNAL_WORKER_SECRET=generate-a-random-64-char-secret
AUDIT_SECRET=generate-a-random-64-char-secret
IP_SALT=generate-a-random-salt-string

# ---------- Feature Flags ----------
ENABLE_DEBUG_ENDPOINTS=false
ENABLE_GITHUB_PR_WRITE=false
